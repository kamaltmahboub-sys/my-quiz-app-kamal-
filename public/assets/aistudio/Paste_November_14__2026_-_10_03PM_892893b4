    function handlePartClick(partId) {
      const part = PHYSICS_PARTS.find((p) => p.id === partId);
      if (!part) return;

      state.selectedPartId = partId;

      if (part.isComprehensive) {
        // Part 11 directly generates 20 random questions across all previous chapters (1–10)
        attemptStartQuiz({ partId: 11, mode: 'comprehensive' });
        return;
      }

      // Parts 1–10: Ask whether student wants "This Part Only" or "Cumulative Revision"
      openModeModal(part);
    }

    function openModeModal(part) {
      const isAr = state.lang === 'ar';
      document.getElementById('mode-modal-title').textContent = t('modeModalTitle');
      document.getElementById('mode-selected-chapter').textContent = isAr ? part.titleAr : part.titleEn;
      document.getElementById('mode-modal-desc').textContent = t('modeModalDesc');
      document.getElementById('mode-single-title').textContent = t('modeSingleTitle');
      document.getElementById('mode-single-sub').textContent = t('modeSingleSub');

      const cumBtn = document.getElementById('btn-mode-cumulative');
      if (part.id === 1) {
        cumBtn.classList.add('hidden');
      } else {
        cumBtn.classList.remove('hidden');
        document.getElementById('mode-cum-title').textContent = t('modeCumTitle');
        document.getElementById('mode-cum-sub').textContent = t('modeCumSub');
      }

      const modal = document.getElementById('mode-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModeModal() {
      const modal = document.getElementById('mode-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function initiateQuizWithMode(mode) {
      closeModeModal();
      attemptStartQuiz({ partId: state.selectedPartId, mode });
    }

    function attemptStartQuiz(config) {
      // Rule: 1st quiz is completely free; subsequent quizzes require the 5-digit access code ONCE
      if (!state.freeQuizUsed || state.isUnlocked) {
        if (!state.freeQuizUsed) {
          state.freeQuizUsed = true;
        }
        startQuizEngine(config);
      } else {
        state.pendingQuizConfig = config;
        openCodeModal();
      }
    }

    function openCodeModal() {
      document.getElementById('code-modal-title').textContent = t('codeModalTitle');
      document.getElementById('code-modal-desc').textContent = t('codeModalDesc');
      document.getElementById('code-error-msg').textContent = t('codeError');
      document.getElementById('code-submit-btn').textContent = t('codeSubmit');

      const input = document.getElementById('access-code-input');
      input.value = '';
      document.getElementById('code-error-msg').classList.add('hidden');

      const modal = document.getElementById('code-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => input.focus(), 100);
    }

    function closeCodeModal() {
      const modal = document.getElementById('code-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function submitAccessCode(e) {
      e.preventDefault();
      const inputVal = document.getElementById('access-code-input').value.trim();
      if (inputVal === APP_CONFIG.accessCode) {
        // Unlocked once for the entire session — will not ask again
        state.isUnlocked = true;
        closeCodeModal();
        showToast(state.lang === 'ar' ? 'تم تفعيل رمز الدخول بنجاح! بالتوفيق في التدريب.' : 'Access code verified! All quizzes are now unlocked.');
        if (state.pendingQuizConfig) {
          const cfg = state.pendingQuizConfig;
          state.pendingQuizConfig = null;
          startQuizEngine(cfg);
        }
      } else {
        document.getElementById('code-error-msg').classList.remove('hidden');
      }
    }

