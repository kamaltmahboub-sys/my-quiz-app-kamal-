    function resetTrialLock() {
      state.freeQuizUsed = true;
      state.isUnlocked = false;
      closeTeacherModal();
      if (state.view === 'physics') renderPhysicsView();
      showToast(state.lang === 'ar' ? 'تم تفعيل القفل: الاختبار القادم سيطلب الرمز.' : 'Access lock active: next quiz will require the 5-digit code.');
    }

    /**
     * =========================================================================
     * QUIZ GENERATOR & QIYAS COMPUTERIZED EXAM ENGINE (60s PER QUESTION)
     * =========================================================================
     */
    function startQuizEngine({ partId, mode }) {
      const part = PHYSICS_PARTS.find((p) => p.id === partId);
      let pool = [];
      let targetCount = APP_CONFIG.questionsPerPartQuiz;

      if (partId === 11 || mode === 'comprehensive') {
        pool = QUESTION_BANK.filter((q) => q.part >= 1 && q.part <= 10);
        targetCount = APP_CONFIG.questionsPerComprehensive; // 20 questions for Part 11
      } else if (mode === 'cumulative') {
        pool = QUESTION_BANK.filter((q) => q.part >= 1 && q.part <= partId);
      } else {
        pool = QUESTION_BANK.filter((q) => q.part === partId);
      }

      const selectedQuestions = shuffleArray(pool).slice(0, targetCount);

      // Initialize a dedicated 60-second timer for each question
      const questionTimers = {};
      selectedQuestions.forEach((_, idx) => {
        questionTimers[idx] = APP_CONFIG.secondsPerQuestion;
      });

      const modeTagAr =
        partId === 11
          ? ''
          : mode === 'cumulative'
            ? ' (مراجعة تراكمية)'
            : ' (هذا القسم فقط)';
      const modeTagEn =
        partId === 11
          ? ''
          : mode === 'cumulative'
            ? ' (Cumulative Revision)'
            : ' (Part Only)';

      state.exam = {
        partId,
        titleAr: `${part.titleAr}${modeTagAr}`,
        titleEn: `${part.titleEn}${modeTagEn}`,
        questions: selectedQuestions,
        currentIndex: 0,
        answers: {},
        flagged: {},
        questionTimers,
        expiredQuestions: {},
        elapsedSeconds: 0,
        timerInterval: null,
        fontSize: 'md'
      };

      state.view = 'exam';
      renderExamView();
      startExamTimer();
    }

    function startExamTimer() {
      if (state.exam.timerInterval) clearInterval(state.exam.timerInterval);

      state.exam.timerInterval = setInterval(() => {
        state.exam.elapsedSeconds++;

        const idx = state.exam.currentIndex;
        if (!state.exam.expiredQuestions[idx]) {
          state.exam.questionTimers[idx] = Math.max(0, (state.exam.questionTimers[idx] ?? APP_CONFIG.secondsPerQuestion) - 1);
          const qRemaining = state.exam.questionTimers[idx];

          const timerDisplay = document.getElementById('exam-timer-text');
          const timerBox = document.getElementById('exam-timer-box');
          const timerBar = document.getElementById('exam-timer-bar');
          if (timerDisplay) {
            timerDisplay.textContent = formatTime(qRemaining);
            if (timerBar) {
              const pct = Math.max(0, Math.min(100, (qRemaining / APP_CONFIG.secondsPerQuestion) * 100));
              timerBar.style.width = `${pct}%`;
              if (qRemaining <= 10) {
                timerBar.classList.remove('bg-qiyas-teal');
                timerBar.classList.add('bg-rose-500');
              }
            }
            if (qRemaining <= 10 && timerBox) {
              timerBox.classList.remove('bg-qiyas-navyLight', 'text-white');
              timerBox.classList.add('bg-rose-600', 'text-white', 'timer-urgent');
            }
          }

          if (qRemaining <= 0) {
            handleQuestionTimeExpired(idx);
          }
        }
      }, 1000);
    }

    function handleQuestionTimeExpired(expiredIdx) {
      state.exam.expiredQuestions[expiredIdx] = true;
      const total = state.exam.questions.length;

      // Find next unexpired question, or finish exam if all questions are completed/expired
      let nextUnexpired = -1;
      for (let i = expiredIdx + 1; i < total; i++) {
        if (!state.exam.expiredQuestions[i]) {
          nextUnexpired = i;
          break;
        }
      }
      if (nextUnexpired === -1) {
        for (let i = 0; i < expiredIdx; i++) {
          if (!state.exam.expiredQuestions[i]) {
            nextUnexpired = i;
            break;
          }
        }
      }

      if (nextUnexpired !== -1) {
        showToast(
          state.lang === 'ar'
            ? `انتهى وقت السؤال ${expiredIdx + 1} (60 ثانية)! تم الانتقال للسؤال التالي.`
            : `Time expired for Question ${expiredIdx + 1} (60s)! Moving to the next question.`
        );
        state.exam.currentIndex = nextUnexpired;
        renderExamView();
      } else {
        showToast(
          state.lang === 'ar'
            ? 'انتهى وقت جميع الأسئلة! جاري عرض النتيجة.'
            : 'Time expired for all questions! Submitting your exam.'
        );
        finishExam();
      }
    }

