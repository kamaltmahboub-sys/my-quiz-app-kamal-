     * =========================================================================
     * TEACHER ACCESS CODE SETTINGS MODAL
     * =========================================================================
     */
    function openTeacherModal() {
      document.getElementById('teacher-modal-title').textContent = t('teacherModalTitle');
      document.getElementById('teacher-modal-desc').innerHTML = `
