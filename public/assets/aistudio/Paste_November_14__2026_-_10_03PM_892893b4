<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SAAT Computerized Practice Platform | منصة التدريب المحوسب للتحصيلي</title>

  <!-- Google Fonts: Inter (English) & Cairo (Arabic) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            qiyas: {
              navy: '#0B2545',
              navyLight: '#13315C',
              teal: '#0D9488',
              tealHover: '#0F766E',
              tealLight: '#CCFBF1',
              surface: '#F1F5F9',
              card: '#FFFFFF',
              gold: '#D97706',
              goldLight: '#FEF3C7'
            }
          }
        }
      }
    };
  </script>

  <style>
    html[dir="rtl"] body {
      font-family: 'Cairo', 'Inter', sans-serif;
    }
    html[dir="ltr"] body {
      font-family: 'Inter', 'Cairo', sans-serif;
    }
    body {
      background-color: #06281E;
      color: #0F172A;
    }

    /* Smooth custom scrollbar */
    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    ::-webkit-scrollbar-track {
      background: #041B14;
    }
    ::-webkit-scrollbar-thumb {
      background: #1E5A46;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #2A7B60;
    }

    /* Qiyas Radio Option Styling */
    .qiyas-option {
      transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .qiyas-option:hover:not(.option-locked) {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px -4px rgba(13, 148, 136, 0.14);
    }

    /* Timer pulse when <= 10s */
    @keyframes pulseUrgent {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }
    .timer-urgent {
      animation: pulseUrgent 1s infinite;
    }

    /* Entrance & floating animations */
    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-view-enter {
      animation: fadeSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-5px) rotate(3deg); }
    }
    .animate-float-slow {
      animation: floatSlow 4s ease-in-out infinite;
    }

    .subject-card {
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s ease, border-color 0.28s ease;
    }
    .subject-card:hover {
      transform: translateY(-4px);
    }

    .bg-subtle-grid {
      background-color: #06281E;
      background-image: radial-gradient(rgba(52, 211, 153, 0.14) 0.9px, transparent 0.9px);
      background-size: 20px 20px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col select-none sm:select-auto bg-subtle-grid">

  <!-- ===================================================================== -->
  <!-- TOP QIYAS COMPUTERIZED HEADER BAR                                     -->
  <!-- ===================================================================== -->
  <header class="bg-[#041B14] text-white shadow-md sticky top-0 z-40 border-b border-emerald-900/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
      <!-- Brand / Qiyas Mock Identity -->
      <div class="flex items-center gap-3 cursor-pointer" onclick="handleLogoClick()">
        <div class="w-10 h-10 rounded-xl bg-qiyas-teal flex items-center justify-center shadow-inner shrink-0">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="leading-tight">
          <h1 id="hdr-title" class="font-bold text-sm sm:text-base tracking-wide text-white">
            SAAT Computerized Practice Exam
          </h1>
          <p id="hdr-subtitle" class="text-[11px] sm:text-xs text-teal-300 font-medium">
            Qiyas Computerized Test Simulation • Smart Practice
          </p>
        </div>
      </div>

      <!-- Right Controls: Teacher Code Info + Compact Language Toggle ('ع') -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Teacher Code Management Button -->
        <button
          id="btn-teacher-settings"
          onclick="openTeacherModal()"
          title="Access Code Settings"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-qiyas-navyLight hover:bg-slate-700 text-xs text-slate-200 border border-slate-600 transition"
        >
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
          <span id="hdr-teacher-btn">Access Code</span>
        </button>

        <!-- Compact Bilingual Toggle Button ('ع' / 'EN') -->
        <button
          onclick="toggleLanguage()"
          title="Switch Language / تغيير اللغة"
          class="w-9 h-9 rounded-xl bg-qiyas-teal hover:bg-qiyas-tealHover text-white font-extrabold shadow transition-all hover:scale-105 active:scale-95 flex items-center justify-center border border-teal-400/30"
        >
          <span id="lang-toggle-text" class="text-[11px] leading-none tracking-tight">ع</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- MAIN DYNAMIC APPLICATION CONTAINER                                    -->
  <!-- ===================================================================== -->
  <main id="app-root" class="flex-1 flex flex-col">
    <!-- Views injected dynamically via JavaScript -->
  </main>

  <!-- ===================================================================== -->
  <!-- MODAL 1: PRACTICE MODE SELECTION (THIS PART ONLY vs CUMULATIVE)       -->
  <!-- ===================================================================== -->
  <div id="mode-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/65 backdrop-blur-xs p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl border border-slate-200 overflow-hidden animate-view-enter">
      <div class="bg-qiyas-navy text-white px-6 py-4 flex items-center justify-between">
        <h3 id="mode-modal-title" class="font-bold text-base sm:text-lg">Choose Practice Mode</h3>
        <button onclick="closeModeModal()" class="text-slate-300 hover:text-white p-1 rounded-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="p-6 space-y-4">
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5">
          <p id="mode-selected-chapter" class="font-bold text-qiyas-navy text-sm sm:text-base"></p>
          <p id="mode-modal-desc" class="text-xs sm:text-sm text-slate-600 mt-1">
            Select how random questions are generated for this session (60 seconds per question):
          </p>
        </div>

        <!-- Option 1: This Part Only -->
        <button
          onclick="initiateQuizWithMode('single')"
          class="w-full text-start p-4 rounded-xl border-2 border-slate-200 hover:border-qiyas-teal hover:bg-teal-50/40 transition group flex items-start gap-3.5"
        >
          <div class="w-10 h-10 rounded-xl bg-teal-100 text-qiyas-teal flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-qiyas-teal group-hover:text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="flex-1">
            <div id="mode-single-title" class="font-bold text-slate-900 text-sm sm:text-base">
              Practice This Part Only
            </div>
            <p id="mode-single-sub" class="text-xs text-slate-600 mt-1 leading-relaxed">
              Generates random questions exclusively from this chapter to test your mastery.
            </p>
          </div>
        </button>

        <!-- Option 2: Revised / Cumulative Version -->
        <button
          id="btn-mode-cumulative"
          onclick="initiateQuizWithMode('cumulative')"
          class="w-full text-start p-4 rounded-xl border-2 border-slate-200 hover:border-amber-500 hover:bg-amber-50/40 transition group flex items-start gap-3.5"
        >
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-amber-600 group-hover:text-white transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div class="flex-1">
            <div id="mode-cum-title" class="font-bold text-slate-900 text-sm sm:text-base">
              Cumulative Revision (This Part + All Previous Parts)
            </div>
            <p id="mode-cum-sub" class="text-xs text-slate-600 mt-1 leading-relaxed">
              Generates random questions pooled from Chapter 1 up to this chapter to reinforce retention.
            </p>
          </div>
        </button>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL 2: 5-DIGIT ACCESS CODE GATE (AFTER 1ST FREE QUIZ)               -->
  <!-- ===================================================================== -->
  <div id="code-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/70 backdrop-blur-xs p-4">
    <div class="bg-white rounded-2xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden animate-view-enter">
      <div class="bg-qiyas-navy text-white px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <h3 id="code-modal-title" class="font-bold text-base sm:text-lg">Enter 5-Digit Access Code</h3>
        </div>
        <button onclick="closeCodeModal()" class="text-slate-300 hover:text-white p-1 rounded-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form onsubmit="submitAccessCode(event)" class="p-6 space-y-5">
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-xs sm:text-sm text-amber-900 leading-relaxed">
          <p id="code-modal-desc">
            You have used your 1st free practice quiz! Enter the 5-digit access code once to unlock all chapters and quizzes.
          </p>
        </div>

        <div>
          <label id="code-input-label" for="access-code-input" class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wider">
            5-Digit Student Access Code
          </label>
          <input
            id="access-code-input"
            type="text"
            inputmode="numeric"
            maxlength="5"
            pattern="[0-9]{5}"
            placeholder="• • • • •"
            autocomplete="off"
            dir="ltr"
            class="w-full text-center text-2xl sm:text-3xl font-extrabold tracking-[0.5em] py-3.5 px-4 rounded-xl border-2 border-slate-300 focus:border-qiyas-teal focus:ring-4 focus:ring-teal-500/15 outline-none transition bg-slate-50"
            required
          />
          <p id="code-error-msg" class="hidden text-rose-600 text-xs font-semibold mt-2 text-center">
            Invalid code! Please check the 5-digit access code and try again.
          </p>
        </div>

        <button
          type="submit"
          id="code-submit-btn"
          class="w-full py-3.5 px-5 rounded-xl bg-qiyas-teal hover:bg-qiyas-tealHover text-white font-bold text-sm sm:text-base shadow-md transition"
        >
          Verify Code & Start Quiz
        </button>
      </form>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL 3: TEACHER ACCESS CODE PREVIEW / UPDATE MODAL                   -->
  <!-- ===================================================================== -->
  <div id="teacher-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/65 backdrop-blur-xs p-4">
    <div class="bg-white rounded-2xl max-w-md w-full shadow-2xl border border-slate-200 overflow-hidden animate-view-enter">
      <div class="bg-slate-800 text-white px-6 py-4 flex items-center justify-between">
        <h3 id="teacher-modal-title" class="font-bold text-base">Student Access Code Settings (Teacher)</h3>
        <button onclick="closeTeacherModal()" class="text-slate-300 hover:text-white p-1 rounded-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="p-6 space-y-4">
        <p id="teacher-modal-desc" class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          The current student 5-digit access code is <strong class="text-qiyas-navy font-mono text-base" id="current-code-display">11223</strong>. You can update it here to test the access gate during this session.
        </p>
        <div class="space-y-2">
          <label id="teacher-input-label" class="block text-xs font-bold text-slate-700">Set new 5-digit code:</label>
          <div class="flex gap-2" dir="ltr">
            <input
              id="teacher-new-code"
              type="text"
              inputmode="numeric"
              maxlength="5"
              placeholder="11223"
              class="flex-1 text-center font-mono text-lg font-bold py-2.5 px-3 rounded-xl border border-slate-300 focus:border-qiyas-teal outline-none"
            />
            <button
              onclick="updateTeacherCode()"
              id="teacher-save-btn"
              class="px-4 py-2.5 rounded-xl bg-qiyas-navy hover:bg-qiyas-navyLight text-white font-bold text-xs sm:text-sm transition"
            >
              Update Code
            </button>
          </div>
        </div>
        <div class="pt-2 border-t border-slate-200 flex items-center justify-between">
          <button
            onclick="resetTrialLock()"
            id="teacher-reset-btn"
            class="text-xs font-semibold text-amber-700 hover:underline"
          >
            Re-lock Trial for Testing
          </button>
          <button
            onclick="closeTeacherModal()"
            class="px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL 4: QIYAS EXAM REVIEW NAVIGATOR GRID                             -->
  <!-- ===================================================================== -->
  <div id="review-grid-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/65 backdrop-blur-xs p-4">
    <div class="bg-white rounded-2xl max-w-xl w-full shadow-2xl border border-slate-200 overflow-hidden animate-view-enter">
      <div class="bg-qiyas-navy text-white px-6 py-4 flex items-center justify-between">
        <h3 id="review-modal-title" class="font-bold text-base sm:text-lg">Question Status Summary</h3>
        <button onclick="closeReviewGridModal()" class="text-slate-300 hover:text-white p-1 rounded-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="p-6 space-y-5">
        <!-- Status Counters -->
        <div class="grid grid-cols-3 gap-3 text-center">
          <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200">
            <div id="stat-answered-count" class="text-xl font-extrabold text-emerald-700">0</div>
            <div id="stat-answered-lbl" class="text-xs font-semibold text-emerald-800">Answered</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-100 border border-slate-200">
            <div id="stat-unanswered-count" class="text-xl font-extrabold text-slate-700">0</div>
            <div id="stat-unanswered-lbl" class="text-xs font-semibold text-slate-600">Unanswered</div>
          </div>
          <div class="p-3 rounded-xl bg-amber-50 border border-amber-200">
            <div id="stat-flagged-count" class="text-xl font-extrabold text-amber-600">0</div>
            <div id="stat-flagged-lbl" class="text-xs font-semibold text-amber-800">Flagged</div>
          </div>
        </div>

        <!-- Question Grid -->
        <div id="review-grid-buttons" class="grid grid-cols-5 gap-2.5">
          <!-- Populated dynamically -->
        </div>

        <div class="bg-rose-50 border border-rose-200 rounded-xl p-3.5 text-xs text-rose-800">
          <p id="end-exam-warn">
            Notice: Ending the exam will submit your answers and display your score report.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-1">
          <button
            onclick="closeReviewGridModal()"
            id="review-continue-btn"
            class="flex-1 py-3 px-4 rounded-xl border-2 border-slate-300 hover:bg-slate-100 text-slate-800 font-bold text-sm transition"
          >
            Return to Questions
          </button>
          <button
            onclick="finishExam()"
            id="review-finish-btn"
            class="flex-1 py-3 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-sm shadow transition"
          >
            End Exam & View Score
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL 5: QIYAS PHYSICS CONSTANTS & FORMULA SHEET                      -->
  <!-- ===================================================================== -->
  <div id="constants-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/65 backdrop-blur-xs p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl border border-slate-200 overflow-hidden animate-view-enter">
      <div class="bg-qiyas-teal text-white px-6 py-4 flex items-center justify-between">
        <h3 id="constants-modal-title" class="font-bold text-base">Physics Constants Reference</h3>
        <button onclick="closeConstantsModal()" class="text-teal-100 hover:text-white p-1 rounded-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="p-6 space-y-3 text-sm" dir="ltr">
        <div class="flex justify-between py-2 border-b border-slate-100">
          <span class="font-semibold text-slate-700">Acceleration due to gravity (g)</span>
          <span class="font-mono font-bold text-qiyas-navy">9.8 m/s<sup>2</sup> (≈ 10 m/s<sup>2</sup>)</span>
        </div>
        <div class="flex justify-between py-2 border-b border-slate-100">
          <span class="font-semibold text-slate-700">Speed of light in vacuum (c)</span>
          <span class="font-mono font-bold text-qiyas-navy">3.00 × 10<sup>8</sup> m/s</span>
        </div>
        <div class="flex justify-between py-2 border-b border-slate-100">
          <span class="font-semibold text-slate-700">Planck's constant (h)</span>
          <span class="font-mono font-bold text-qiyas-navy">6.626 × 10<sup>-34</sup> J·s</span>
        </div>
        <div class="flex justify-between py-2 border-b border-slate-100">
          <span class="font-semibold text-slate-700">Elementary charge (e)</span>
          <span class="font-mono font-bold text-qiyas-navy">1.60 × 10<sup>-19</sup> C</span>
        </div>
        <div class="flex justify-between py-2">
          <span class="font-semibold text-slate-700">Coulomb's constant (K)</span>
          <span class="font-mono font-bold text-qiyas-navy">9.0 × 10<sup>9</sup> N·m<sup>2</sup>/C<sup>2</sup></span>
        </div>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- TOAST NOTIFICATION BANNER (NO ALERT() USED ANYWHERE)                  -->
  <!-- ===================================================================== -->
  <div id="toast-box" class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 hidden">
    <div id="toast-msg" class="bg-slate-900 text-white text-xs sm:text-sm font-semibold px-5 py-3 rounded-xl shadow-xl border border-slate-700"></div>
  </div>

  <!-- ===================================================================== -->
  <!-- JAVASCRIPT APPLICATION LOGIC & QUESTION BANK                          -->
  <!-- ===================================================================== -->
  <script>
    /**
     * =========================================================================
     * CONFIGURATION & ACCESS CODE SETTINGS
     * =========================================================================
     * Update `accessCode` below whenever you want to change the 5-digit student code.
     */
    const APP_CONFIG = {
      accessCode: '11223',              // Default 5-digit access code
      questionsPerPartQuiz: 10,         // Up to 10 random questions for Parts 1–10
      questionsPerComprehensive: 20,    // 20 random questions for Part 11
      secondsPerQuestion: 60            // 60 seconds timer per question
    };

    /**
     * =========================================================================
     * PHYSICS 11 PARTS METADATA
     * =========================================================================
     */
    const PHYSICS_PARTS = [
      {
        id: 1,
        titleEn: "Chapter 1: The Science of Physics",
        subEn: "Scientific Method, Hypotheses, Laws & Theories",
        titleAr: "القسم 1: علم الفيزياء",
        subAr: "الطريقة العلمية، الفرضيات، القوانين والنظريات"
      },
      {
        id: 2,
        titleEn: "Chapter 2: Mechanics",
        subEn: "Motion, Forces, Gravity, Torque & Equilibrium",
        titleAr: "القسم 2: الميكانيكا",
        subAr: "الحركة، القوى، الجاذبية، العزم والاتزان"
      },
      {
        id: 3,
        titleEn: "Chapter 3: Energy, Work & Momentum",
        subEn: "Collisions, Momentum, Work, Power & Conservation",
        titleAr: "القسم 3: الطاقة والشغل والزخم",
        subAr: "التصادمات، الزخم، الشغل، القدرة وحفظ الطاقة"
