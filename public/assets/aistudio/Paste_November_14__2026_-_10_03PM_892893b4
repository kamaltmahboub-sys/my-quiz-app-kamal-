        <strong class="text-qiyas-navy font-mono text-base mx-1">${APP_CONFIG.accessCode}</strong>.
        ${t('teacherModalDescSuffix')}
      `;
      document.getElementById('teacher-input-label').textContent = t('teacherInputLabel');
      document.getElementById('teacher-save-btn').textContent = t('teacherSave');
      document.getElementById('teacher-reset-btn').textContent = t('teacherReset');
