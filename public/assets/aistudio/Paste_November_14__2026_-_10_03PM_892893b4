    function updateTeacherCode() {
      const val = document.getElementById('teacher-new-code').value.trim();
      if (/^\d{5}$/.test(val)) {
        APP_CONFIG.accessCode = val;
        closeTeacherModal();
        showToast(state.lang === 'ar' ? `تم تحديث رمز الدخول إلى ${val}` : `Access code updated to ${val}`);
      } else {
        showToast(state.lang === 'ar' ? 'يرجى إدخال 5 أرقام صحيحة.' : 'Please enter exactly 5 digits.');
