    function selectOption(optIdx) {
      if (state.exam.expiredQuestions[state.exam.currentIndex]) return;
      state.exam.answers[state.exam.currentIndex] = optIdx;
      playUiTone('select');
      renderExamView();
    }

    function toggleFlagCurrent() {
      const idx = state.exam.currentIndex;
      if (state.exam.flagged[idx]) {
        delete state.exam.flagged[idx];
      } else {
        state.exam.flagged[idx] = true;
      }
      playUiTone('flag');
      renderExamView();
    }

    function setExamFontSize(size) {
      state.exam.fontSize = size;
      renderExamView();
    }

    function prevQuestion() {
      if (state.exam.currentIndex > 0) {
        state.exam.currentIndex--;
        renderExamView();
      }
    }

    function nextQuestion() {
      if (state.exam.currentIndex < state.exam.questions.length - 1) {
        state.exam.currentIndex++;
        renderExamView();
      }
    }

    function jumpToQuestion(idx) {
      state.exam.currentIndex = idx;
      closeReviewGridModal();
      renderExamView();
    }

    /**
     * =========================================================================
     * EXAM REVIEW GRID & CONSTANTS MODALS
     * =========================================================================
     */
    function openReviewGridModal() {
      const { questions, answers, flagged } = state.exam;
      const total = questions.length;
      const answeredCount = Object.keys(answers).length;
      const flaggedCount = Object.keys(flagged).length;
      const unansweredCount = total - answeredCount;

      document.getElementById('review-modal-title').textContent = t('reviewModalTitle');
      document.getElementById('stat-answered-count').textContent = answeredCount;
      document.getElementById('stat-answered-lbl').textContent = t('statAnswered');
      document.getElementById('stat-unanswered-count').textContent = unansweredCount;
      document.getElementById('stat-unanswered-lbl').textContent = t('statUnanswered');
      document.getElementById('stat-flagged-count').textContent = flaggedCount;
      document.getElementById('stat-flagged-lbl').textContent = t('statFlagged');
      document.getElementById('end-exam-warn').textContent = t('endExamWarn');
      document.getElementById('review-continue-btn').textContent = t('reviewContinueBtn');
      document.getElementById('review-finish-btn').textContent = t('reviewFinishBtn');

      const grid = document.getElementById('review-grid-buttons');
      grid.innerHTML = questions
        .map((_, idx) => {
          const isAns = answers[idx] !== undefined;
          const isFlg = !!flagged[idx];
          let cls = 'bg-slate-100 text-slate-700 border-slate-300';
          if (isFlg) cls = 'bg-amber-400 text-slate-950 border-amber-500 font-extrabold';
          else if (isAns) cls = 'bg-emerald-600 text-white border-emerald-700 font-bold';

          return `
            <button
              onclick="jumpToQuestion(${idx})"
              class="py-2.5 rounded-xl border text-sm transition hover:opacity-90 ${cls}"
            >
              ${idx + 1}
            </button>
          `;
        })
        .join('');

      const modal = document.getElementById('review-grid-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeReviewGridModal() {
      const modal = document.getElementById('review-grid-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function openConstantsModal() {
      document.getElementById('constants-modal-title').textContent = t('constantsBtn');
      const modal = document.getElementById('constants-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeConstantsModal() {
      const modal = document.getElementById('constants-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function finishExam() {
      clearInterval(state.exam.timerInterval);
      closeReviewGridModal();

      // Record session mastery stats for the completed chapter
      const { questions, answers, partId } = state.exam;
      if (partId && questions.length > 0) {
        let correctCount = 0;
        questions.forEach((q, idx) => {
          if (answers[idx] === q.correct) correctCount++;
        });
        const pct = Math.round((correctCount / questions.length) * 100);
        const prev = state.chapterStats[partId] || { attempts: 0, bestPct: 0 };
        state.chapterStats[partId] = {
          attempts: prev.attempts + 1,
          bestPct: Math.max(prev.bestPct, pct)
        };
      }

      playUiTone('complete');
      state.view = 'results';
      renderResultsView();
    }

    /**
     * =========================================================================
     * VIEW 4: DETAILED SCORE REPORT & ANSWER REVIEW
     * =========================================================================
     */
    function renderResultsView() {
      const root = document.getElementById('app-root');
      const isAr = state.lang === 'ar';
      const { questions, answers, elapsedSeconds } = state.exam;
      const total = questions.length;
      const letters = t('optionLetters');

      let correctCount = 0;
      questions.forEach((q, idx) => {
        if (answers[idx] === q.correct) correctCount++;
      });
      const wrongCount = total - correctCount;
      const percentage = Math.round((correctCount / total) * 100);

      const badgeColor =
        percentage >= 80
          ? 'text-emerald-600 bg-emerald-50 border-emerald-200'
          : percentage >= 60
            ? 'text-amber-600 bg-amber-50 border-amber-200'
            : 'text-rose-600 bg-rose-50 border-rose-200';

      const reviewCardsHtml = questions
        .map((q, idx) => {
          const userAns = answers[idx];
          const isCorrect = userAns === q.correct;
          const opts = isAr ? q.optionsAr : q.optionsEn;

          return `
            <div class="bg-white rounded-2xl p-5 sm:p-6 shadow-xs border-2 ${
              isCorrect ? 'border-emerald-200' : 'border-rose-200'
            } space-y-4">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-start gap-3">
                  <span class="w-8 h-8 rounded-lg font-extrabold text-sm flex items-center justify-center shrink-0 ${
                    isCorrect ? 'bg-emerald-600 text-white' : 'bg-rose-600 text-white'
                  }">
                    ${idx + 1}
                  </span>
                  <p class="font-bold text-slate-900 text-base sm:text-lg leading-relaxed">
                    ${isAr ? q.qAr : q.qEn}
                  </p>
                </div>
                <span class="px-2.5 py-1 rounded-lg text-xs font-extrabold shrink-0 ${
                  isCorrect ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'
                }">
                  ${isCorrect ? '✓' : '✕'}
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                <!-- Student Choice -->
                <div class="p-3.5 rounded-xl border ${
                  isCorrect
                    ? 'bg-emerald-50/70 border-emerald-200 text-emerald-900'
                    : 'bg-rose-50/70 border-rose-200 text-rose-900'
                }">
                  <span class="block text-xs font-bold opacity-75 mb-1">${t('yourAnswerLabel')}</span>
                  <span class="font-bold">
                    ${
                      userAns !== undefined
                        ? `${letters[userAns]}) ${opts[userAns]}`
                        : t('notAnsweredLabel')
                    }
                  </span>
                </div>

                <!-- Correct Choice -->
                <div class="p-3.5 rounded-xl bg-teal-50/80 border border-teal-200 text-teal-950">
                  <span class="block text-xs font-bold text-qiyas-teal mb-1">${t('correctAnswerLabel')}</span>
                  <span class="font-bold">${letters[q.correct]}) ${opts[q.correct]}</span>
                </div>
              </div>

              <!-- Scientific Explanation -->
              <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-700 leading-relaxed">
                <strong class="text-qiyas-navy">${t('explanationLabel')}</strong>
                ${isAr ? q.expAr : q.expEn}
              </div>
            </div>
          `;
        })
        .join('');

      root.innerHTML = `
        <div class="max-w-5xl mx-auto w-full px-4 sm:px-6 py-8 space-y-8 animate-view-enter">
          <!-- Score Summary Card -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-5">
              <div>
                <span class="text-xs font-bold text-qiyas-teal uppercase tracking-wider">${t('resultsHeader')}</span>
                <h2 class="text-xl sm:text-2xl font-extrabold text-qiyas-navy mt-1">
                  ${isAr ? state.exam.titleAr : state.exam.titleEn}
                </h2>
              </div>

              <div class="px-5 py-3 rounded-2xl border-2 text-center ${badgeColor}">
                <div class="text-xs font-bold uppercase">${t('scoreLabel')}</div>
                <div class="text-3xl font-extrabold">${percentage}%</div>
              </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-3 gap-3 sm:gap-5 text-center">
              <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200">
                <div class="text-2xl sm:text-3xl font-extrabold text-emerald-700">${correctCount} / ${total}</div>
                <div class="text-xs font-bold text-emerald-800 mt-1">${t('correctCountLabel')}</div>
              </div>

              <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200">
                <div class="text-2xl sm:text-3xl font-extrabold text-rose-700">${wrongCount}</div>
                <div class="text-xs font-bold text-rose-800 mt-1">${t('wrongCountLabel')}</div>
              </div>

              <div class="p-4 rounded-2xl bg-slate-100 border border-slate-200">
                <div class="text-2xl sm:text-3xl font-extrabold text-qiyas-navy font-mono">${formatTime(elapsedSeconds)}</div>
                <div class="text-xs font-bold text-slate-600 mt-1">${t('timeSpentLabel')}</div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 pt-2">
              <button
                onclick="handlePartClick(${state.selectedPartId || 1})"
                class="flex-1 py-3.5 px-5 rounded-xl bg-qiyas-teal hover:bg-qiyas-tealHover text-white font-bold text-sm shadow transition"
              >
                ${t('retryNewRandomBtn')}
              </button>
              <button
                onclick="navigateTo('physics')"
                class="flex-1 py-3.5 px-5 rounded-xl border-2 border-slate-300 hover:bg-slate-100 text-slate-800 font-bold text-sm transition"
              >
                ${t('backToPartsBtn')}
              </button>
            </div>
          </div>

          <!-- Detailed Question-by-Question Review -->
          <div class="space-y-4">
            <h3 class="text-lg sm:text-xl font-extrabold text-white px-1">
              ${t('detailedReviewTitle')}
            </h3>
            ${reviewCardsHtml}
          </div>
        </div>
      `;
    }

    // Keyboard shortcuts during computerized exam (1-4 / A-D to answer, F to flag, Arrows to navigate)
    document.addEventListener('keydown', (e) => {
      if (state.view !== 'exam') return;
      if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) return;

      const key = e.key.toUpperCase();
      if (['1', 'A'].includes(key)) selectOption(0);
      else if (['2', 'B'].includes(key)) selectOption(1);
      else if (['3', 'C'].includes(key)) selectOption(2);
      else if (['4', 'D'].includes(key)) selectOption(3);
      else if (key === 'F') toggleFlagCurrent();
      else if (e.key === 'ArrowRight') {
        state.lang === 'ar' ? prevQuestion() : nextQuestion();
      } else if (e.key === 'ArrowLeft') {
        state.lang === 'ar' ? nextQuestion() : prevQuestion();
      }
    });

    // Initialize Application on Load
    window.onload = function () {
      updateHeaderUI();
      renderCurrentView();
    };
  </script>
</body>
</html>